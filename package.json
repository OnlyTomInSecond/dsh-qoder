{
  "name": "@local/dsh-llm-qoder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone DeepSeek Harness provider plugin for Qoder AI models and quota",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/smoke.mjs",
    "scripts/config-card-smoke.mjs",
    "scripts/client-card-smoke.mjs",
    "scripts/quota-smoke.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "npm run build",
    "smoke:config": "node scripts/config-card-smoke.mjs",
    "smoke:client": "node scripts/client-card-smoke.mjs",
    "smoke:quota": "node scripts/quota-smoke.mjs",
    "check": "npm run smoke:config && npm run smoke:client && npm run smoke:quota"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "esbuild": "^0.28.1"
  }
}
